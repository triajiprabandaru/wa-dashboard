# Salin file ini menjadi ".env" di root proyek (folder tempat perintah python dijalankan).
# JANGAN membagikan isi .env ke siapa pun, termasuk ke chat AI, dan jangan unggah ke GitHub.

# Supabase > tombol "Connect" > Session pooler (port 5432). Gunakan pooler, bukan "Direct connection",
# karena koneksi langsung hanya IPv6 dan sering gagal di jaringan rumah/kantor.
# Jika password mengandung karakter khusus (@ # / : dll.), ubah menjadi URL-encoded (mis. @ -> %40).
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Alternatif yang lebih aman untuk password berkarakter khusus (tidak perlu URL-encode).
# Jika DB_HOST diisi, nilai ini dipakai dan DATABASE_URL diabaikan.
# DB_HOST=aws-0-REGION.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.PROJECTREF
# DB_PASSWORD=
# DB_NAME=postgres

# Google Drive — unduh JSON OAuth client (tipe Desktop) dari Google Cloud Console,
# simpan sebagai google_client.json, lalu jalankan: python scripts/wa_drive.py auth
GOOGLE_CLIENT_SECRET_FILE=google_client.json
GOOGLE_TOKEN_FILE=google_token.json

# Folder inbox untuk wa_sync.py (opsional; default: folder "inbox" di root proyek).
# WA_INBOX_DIR=C:\WA-Inbox
